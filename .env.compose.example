# Copy to .env.compose, fill in real values, then:
#   docker compose --env-file .env.compose up -d --build

DB_PASSWORD=choose-a-real-password
PINECONE_API_KEY=
PINECONE_INDEX_URL=
GROQ_API_KEY=
JWT_SECRET=generate-a-long-random-string-do-not-reuse-the-dev-one

# Your actual domain/IP once you have one, e.g. https://yourapp.com
FRONTEND_ORIGIN=http://localhost
# Same origin, used when baking the frontend's build-time API URLs
FRONTEND_ORIGIN_API=http://localhost:8080
FRONTEND_ORIGIN_WS=ws://localhost:9000
