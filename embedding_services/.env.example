# Copy to .env and fill in real values. This file is safe to commit -
# .env itself is gitignored.

# Not currently used by the live voice path (only the dead
# services/llm_service.py), but required for that file to import.
GROQ_API_KEY=

# Where the Java backend lives. Defaults to localhost:8080 if unset -
# only needs setting for a real deployment.
JAVA_BACKEND_URL=http://localhost:8080
