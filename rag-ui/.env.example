# Copy to .env.local for local overrides, or set these in your hosting
# platform's dashboard for a real deployment. Both are optional for
# local dev - unset, everything defaults to localhost.

# The Java backend's base URL.
VITE_API_BASE_URL=http://localhost:8080

# The Python voice service's WebSocket URL. MUST be wss:// (not ws://)
# in any real deployment - the page is served over HTTPS there, and
# browsers block a plain ws:// connection from a secure page.
VITE_VOICE_WS_URL=ws://localhost:9000
